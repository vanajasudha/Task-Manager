# ─────────────────────────────────────────────────────────────────────────────
# TaskFlow Frontend — Environment Variables
# Copy this file to .env.local for local dev, or set in Vercel dashboard.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

# ── API URL ───────────────────────────────────────────────────────────────────
# In development: leave this unset — Vite's proxy forwards /api → localhost:8000
# In production:  set to your deployed FastAPI URL + /api/v1
#
# Render example:  https://taskflow-api.onrender.com/api/v1
# Railway example: https://taskflow-api.up.railway.app/api/v1
VITE_API_BASE_URL=https://your-api.onrender.com/api/v1
