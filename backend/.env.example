# ────────────────────────────────────────────────────────────────────────────
# TaskFlow API — Environment Configuration
# Copy this file to .env and fill in every value before starting the server.
# Lines starting with # are comments and are ignored.
# ────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
# One of: development | staging | production
# production disables /docs and /redoc Swagger UI endpoints.
APP_ENV=production
DEBUG=false

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Atlas dashboard → Cluster → Connect → Drivers → copy connection string.
# Replace <username>, <password>, and <cluster> with your Atlas credentials.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=TaskFlow
MONGO_DB_NAME=task_management_db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-64-char-random-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
# Set to your Vercel deployment URL in production.
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# Application type: Web application
# Authorised JavaScript origins: http://localhost:5173 (dev) + your Vercel URL (prod)
# Authorised redirect URIs: not needed for this implicit-flow setup
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Format: "<count>/<period>"  e.g. "60/minute", "1000/hour", "10000/day"
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute
